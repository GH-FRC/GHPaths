{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GHPaths",
  "version": "0.1.0",
  "identifier": "org.gh-frc.ghpaths",
  "build": {
    "beforeDevCommand": "node ../../scripts/prepare-sidecars.mjs && npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "node ../../scripts/prepare-sidecars.mjs && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GHPaths 演控台",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "externalBin": [
      "binaries/node",
      "binaries/ghpaths-sim.cjs",
      "binaries/ghpaths-multids.cjs"
    ]
  }
}
